# PostgreSQL propio de Lime AI Studio — NO reutilizar el de ConsentsPro
DATABASE_URL=postgresql://user:password@localhost:5432/lime

# Genera cada una con: openssl rand -hex 32 (dos claves DISTINTAS)
LIME_JWT_SECRET=
LIME_ENCRYPTION_KEY=

PORT=3101
NODE_ENV=development

# Orígenes permitidos para CORS (frontend de Lime), separados por coma
APP_URL=http://localhost:5173

# Número de WhatsApp (YCloud) usado para el envío cuando un cliente no tiene
# su propio número dedicado configurado
YCLOUD_WA_NUMBER=
